# If DISCORD_GATEWAY_TOKEN is unset, the gateway falls back to DISCORD_TOKEN.
DISCORD_GATEWAY_TOKEN="replace_with_gateway_bot_token"

# If CONTROL_GUILD_ID is unset, the gateway falls back to DISCORD_GUILD_ID.
CONTROL_GUILD_ID="1494463231647813736"
CONTROL_CHANNEL_ID="replace_with_control_channel_id"
ALLOWED_USER_IDS="replace_with_your_discord_user_id"

CODEX_BIN="codex"
CODEX_CWD="/home/boor123/work/codex_sandbox"

# Optional sandbox-compatibility override for environments where Codex cannot
# write to the default HOME/.codex path.
# CODEX_HOME_PARENT="/tmp/codex_gateway_runtime/codex-home"
# CODEX_HOME_SEED_FROM="/home/boor123/.codex"

# Optional override for the Codex home directory that `/status` should inspect
# when summarizing the latest assistant response across terminal + Discord work.
# CODEX_STATUS_HOME="/home/boor123/.codex"

PROMPT_MAX_CHARS="4000"
STATUS_TEXT_MAX_CHARS="700"
RESPONSE_PREVIEW_CHARS="20"
STREAM_TAIL_CHARS="2000"
STOP_SIGINT_GRACE_SECONDS="5"
STOP_SIGTERM_GRACE_SECONDS="5"

# Optional overrides
# STATE_FILE="/tmp/codex_gateway_runtime/gateway_state.json"
# TMP_DIR="/tmp/codex_gateway_runtime/tmp"
# LAST_RESPONSE_FILE="/tmp/codex_gateway_runtime/tmp/last_response.txt"
