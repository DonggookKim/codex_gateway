# ==== Discord ====================================================
# Falls back to DISCORD_TOKEN if DISCORD_GATEWAY_TOKEN is unset.
DISCORD_GATEWAY_TOKEN="replace_with_gateway_bot_token"

# Falls back to DISCORD_GUILD_ID if CONTROL_GUILD_ID is unset.
CONTROL_GUILD_ID="replace_with_control_guild_id"
CONTROL_CHANNEL_ID="replace_with_control_channel_id"

# Comma-separated Discord user IDs allowed to issue gateway commands.
ALLOWED_USER_IDS="replace_with_your_discord_user_id"

# ==== codex backend (default) ====================================
CODEX_BIN="codex"
# Working directory codex sessions run in. Required.
CODEX_CWD="/path/to/your/codex/workspace"

# ==== Storage ====================================================
STATE_ROOT="/path/to/codex_gateway/state"
RUNTIME_ROOT="$HOME/codex_gateway_runtime"
PROJECTS_FILE="/path/to/codex_gateway/state/projects.json"

# Optional storage overrides
# STATE_FILE="/path/to/codex_gateway/state/gateway_state.json"
# TMP_DIR="$HOME/codex_gateway_runtime/tmp"
# LAST_RESPONSE_FILE="$HOME/codex_gateway_runtime/tmp/last_response.txt"

# Optional sandbox-compatibility override for environments where codex
# cannot write to the default HOME/.codex path.
# CODEX_HOME_PARENT="$HOME/codex_gateway_runtime/codex-home"
# CODEX_HOME_SEED_FROM="$HOME/.codex"

# Optional override for the codex home directory that `/status` should
# inspect when summarizing the latest assistant response.
# CODEX_STATUS_HOME="$HOME/.codex"

# Optional shared-auth source for codex sessions; defaults to ~/.codex/auth.json.
# OPENAI_SHARED_AUTH_SOURCE="$HOME/.codex/auth.json"

# ==== Sizing / timing knobs (optional) ===========================
PROMPT_MAX_CHARS="4000"
STATUS_TEXT_MAX_CHARS="700"
RESPONSE_PREVIEW_CHARS="20"
STREAM_TAIL_CHARS="2000"
STOP_SIGINT_GRACE_SECONDS="5"
STOP_SIGTERM_GRACE_SECONDS="5"

# ==== opencode backend (opt-in) ==================================
# Set OPENCODE_GATEWAY_ENABLED=1 (or true/yes) to start an `opencode serve`
# alongside the gateway. Required when any session uses backend=opencode.
# OPENCODE_GATEWAY_ENABLED="1"
# OPENCODE_PROVIDER_ID="model-connect"
# OPENCODE_MODEL_ID="Qwen3.5-397B-A17B-FP8"

# Optional opencode runtime knobs
# OPENCODE_BIN="opencode"
# OPENCODE_SERVER_PORT="14096"
# OPENCODE_SERVER_HOSTNAME="127.0.0.1"
# OPENCODE_SERVER_PASSWORD="optional-basic-auth-password"
# OPENCODE_DEFAULT_AGENT="build"
# OPENCODE_IDLE_TIMEOUT_SECONDS="7200"
